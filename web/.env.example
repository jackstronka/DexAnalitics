# Copy to `.env` or `.env.local` in this directory (both are gitignored by root `.env` rule).
# Restart `npm run dev` after changes.

# Solana pubkey (base58) — shown in the shell as the pinned test/operator wallet.
# Default for dev is also in `.env.development` (committed).
VITE_DEV_WALLET_PUBKEY=8s9BcTUTXmWmZVPDrkoMNKsU6n1dRsihySv1bSteSvMQ

# Optional: disable WebSockets in UI (avoids Vite ws proxy spam during frequent API restarts)
VITE_DISABLE_WS=0
