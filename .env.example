# =============================================================================
# Bociarz LP - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit your .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Solana RPC Configuration
# -----------------------------------------------------------------------------

# Primary RPC endpoint (required for blockchain operations)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Fallback RPC endpoints (comma-separated, same cluster as primary). Read by `RpcConfig` / CLI bot.
# (Legacy name `SOLANA_RPC_BACKUP_URLS` is not read by this repo — use this variable.)
SOLANA_RPC_FALLBACK_URLS=https://solana-api.projectserum.com,https://rpc.ankr.com/solana

# Fail-fast if inferable RPC URLs point at the wrong cluster (mainnet-beta | devnet | testnet | localnet).
# Recommended on mainnet live: CLMM_EXPECTED_CLUSTER=mainnet-beta
# CLMM_EXPECTED_CLUSTER=mainnet-beta

# RPC request timeout in seconds (default: 30)
SOLANA_RPC_TIMEOUT_SECS=30

# Maximum retries for failed RPC requests (default: 3)
SOLANA_RPC_MAX_RETRIES=3

# Commitment level: processed, confirmed, finalized (default: confirmed)
SOLANA_COMMITMENT=confirmed

# Orca Whirlpool: default close-position slippage (basis points) when CLI/API passes none. Prefer low (100).
# Raise only if closes fail with 6018 (TokenMinSubceeded), or set per-invocation via CLI --slippage-bps.
# WHIRLPOOL_CLOSE_SLIPPAGE_BPS=100

# -----------------------------------------------------------------------------
# Data Providers
# -----------------------------------------------------------------------------

# Birdeye API key for market data (required for analyze/backtest commands)
# Get your API key at: https://birdeye.so/
BIRDEYE_API_KEY=your_birdeye_api_key_here

# Jupiter Price API v2 (USD). Without JUPITER_API_KEY many hosts get HTTP 401; the API falls back to
# DexPaprika + Dexscreener for mints. Get a key at https://portal.jup.ag/ (or Jupiter docs).
JUPITER_PRICE_API_URL=https://api.jup.ag/price/v2
# JUPITER_API_KEY=
# Free tier (portal): ~1 req/s, ~60 req/min (60s sliding window); all Jupiter endpoints share one bucket — see https://dev.jup.ag/docs/portal/rate-limit

# -----------------------------------------------------------------------------
# Alerts — Slack Incoming Webhook (optional)
# -----------------------------------------------------------------------------
# Create at https://api.slack.com/apps → Incoming Webhooks → channel e.g. #lp-bot-alerts
# Copy .env.example to .env (gitignored) and set the real URL only there — never commit it.
# PowerShell: .\tools\notify_slack_webhook.ps1 -Text 'test'
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE_ME/REPLACE_ME/REPLACE_ME

# -----------------------------------------------------------------------------
# Database Configuration (Optional)
# -----------------------------------------------------------------------------

# PostgreSQL connection URL
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://clmm_user:clmm_password@localhost:5432/clmm_lp

# Database pool size (default: 5)
DATABASE_POOL_SIZE=5

# -----------------------------------------------------------------------------
# API Server Configuration
# -----------------------------------------------------------------------------

# API server host (default: 0.0.0.0)
API_HOST=0.0.0.0

# API server port (default: 8080)
API_PORT=8080

# Enable CORS for all origins (default: true for development)
API_CORS_ALLOW_ALL=true

# Request timeout in seconds (default: 30)
API_REQUEST_TIMEOUT_SECS=30

# Longer timeout for on-chain / tx endpoints (`POST /positions`, rebalance, swap-before-open).
# Default: 120. Increase if your RPC is slow / rate-limited.
API_ONCHAIN_REQUEST_TIMEOUT_SECS=120

# Rate limiting: requests per minute (default: 100)
API_RATE_LIMIT_RPM=100

# Repo root on the API host (optional). Used with default `target/debug|release/clmm-lp-cli` resolution for `POST /backtests/from-closed-position`.
# CLMM_REPO_ROOT=

# Full path to the `clmm-lp-cli` executable (optional). Use on Windows if the CLI is not on PATH, e.g. F:\...\target\debug\clmm-lp-cli.exe
# CLMM_LP_CLI_PATH=

# -----------------------------------------------------------------------------
# Orca position lifecycle JSONL (tx costs + fee_payer_token_deltas)
# -----------------------------------------------------------------------------
# Canonical append path (bot/CLI writes here). Default: data/ledger/orca_position_lifecycle.jsonl
# CLMM_POSITION_LIFECYCLE_LEDGER_PATH=data/ledger/orca_position_lifecycle.jsonl
#
# Reads (API dashboard, lineage, aggregates) — optional overrides:
# CLMM_POSITION_LIFECYCLE_LEDGER_READ_PATH=
# If true and sibling file exists: use <stem>.enriched.jsonl next to the canonical ledger (from enrich-lifecycle-ledger / make enrich-lifecycle-ledger).
# CLMM_POSITION_LIFECYCLE_USE_ENRICHED=true

# -----------------------------------------------------------------------------
# Local scripts runner (localhost allowlist)
# -----------------------------------------------------------------------------
# The API proxies tool runs to tools/script_runner/Start-ClmmScriptRunner.ps1.
# You must set the same shared secret on both sides (API + runner).
#
# Runner URL (default runner port is 9847)
SCRIPT_RUNNER_URL=http://127.0.0.1:9847
#
# Shared secret for API -> runner (Authorization: Bearer <token>)
SCRIPT_RUNNER_TOKEN=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET
#
# Runner side variable (tools/script_runner/Start-ClmmScriptRunner.ps1 reads this)
CLMM_SCRIPT_RUNNER_TOKEN=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET

# -----------------------------------------------------------------------------
# Wallets directory (keypair JSON files on API host)
# -----------------------------------------------------------------------------
# Folder on disk that contains Solana keypair JSON files (1 file = 1 wallet entry in the dashboard).
# Example:
#   CLMM_WALLETS_DIR=F:\\sec\\clmm-wallets
CLMM_WALLETS_DIR=

# -----------------------------------------------------------------------------
# Authentication Configuration
# -----------------------------------------------------------------------------

# JWT secret key (CHANGE THIS IN PRODUCTION!)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT token expiration in seconds (default: 3600 = 1 hour)
JWT_EXPIRY_SECS=3600

# API keys for authentication (comma-separated)
# Example: API_KEYS=key1,key2,key3
API_KEYS=

# Require authentication for API access (default: false for development)
API_REQUIRE_AUTH=false

# -----------------------------------------------------------------------------
# Wallet Configuration
# -----------------------------------------------------------------------------

# Path to wallet keypair JSON file (for transaction signing)
WALLET_KEYPAIR_PATH=~/.config/solana/id.json

# Or provide the keypair as a base58 encoded string
# WALLET_KEYPAIR_BASE58=your_base58_encoded_private_key

# Wallet label for identification
WALLET_LABEL=default

# -----------------------------------------------------------------------------
# Orca LP bot CLI (`orca-bot-run`, `clmm-lp-cli`) — production fast path
# -----------------------------------------------------------------------------
# See doc/PRODUCTION_FAST_PATH.md. These are separate from API `WEBHOOK_URL` above.

# Signing for `--execute`: `--keypair` or env (first match wins in loader):
#   KEYPAIR_PATH, SOLANA_KEYPAIR_PATH (file), SOLANA_KEYPAIR (JSON/base58).
# CLMM_ALERT_WEBHOOK_URL=https://example.com/hooks/clmm-alerts
# After rebalance incomplete (close OK, open failed); default path if unset when using --execute:
# CLMM_PENDING_OPEN_RECOVERY_PATH=data/pending-open-recovery.json
# CLMM_PENDING_OPEN_MAX_ATTEMPTS=100
# Profitability gate after dry-run estimate: off | warn | block (default off)
# CLMM_REBALANCE_PROFITABILITY=off
# CLMM_REBALANCE_EST_TX_COST_LAMPORTS=500000
#
# Rebalance swap-mix (align wallet to deposit quote before `open_position`):
# CLMM_REBALANCE_SWAP_MAX_ROUNDS=10
# Fraction of the spendable leg to use per swap (default 0.988; older code used 0.92 → extra round + tx fee).
# CLMM_SWAP_MIX_SPEND_CAP_PCT=0.988
# Buffer on USD-derived amount_in (default 1.03).
# CLMM_SWAP_MIX_AMOUNT_IN_BUFFER_PCT=1.03
# Converge if remaining deficit below this USD notional (default 0.25).
# CLMM_SWAP_MIX_DEFICIT_USD_EPS=0.25

# -----------------------------------------------------------------------------
# Execution Configuration
# -----------------------------------------------------------------------------

# Enable dry run mode (simulate transactions without executing)
# IMPORTANT: Set to false only when ready for live trading!
DRY_RUN=true

# Maximum slippage tolerance in basis points (default: 50 = 0.5%)
MAX_SLIPPAGE_BPS=50

# Transaction priority fee in microlamports (default: 1000)
PRIORITY_FEE_MICROLAMPORTS=1000

# Confirmation timeout in seconds (default: 60)
TX_CONFIRMATION_TIMEOUT_SECS=60

# -----------------------------------------------------------------------------
# Strategy Configuration
# -----------------------------------------------------------------------------

# Default rebalance threshold percentage (default: 5.0)
DEFAULT_REBALANCE_THRESHOLD_PCT=5.0

# Default maximum impermanent loss percentage (default: 2.0)
DEFAULT_MAX_IL_PCT=2.0

# Minimum interval between rebalances in hours (default: 4)
MIN_REBALANCE_INTERVAL_HOURS=4

# Circuit breaker: max consecutive losses before pause (default: 3)
CIRCUIT_BREAKER_MAX_LOSSES=3

# Circuit breaker: cooldown period in hours (default: 24)
CIRCUIT_BREAKER_COOLDOWN_HOURS=24

# -----------------------------------------------------------------------------
# Monitoring & Alerts
# -----------------------------------------------------------------------------

# Position monitoring interval in seconds (default: 30)
MONITOR_INTERVAL_SECS=30

# Enable webhook notifications
WEBHOOK_ENABLED=false

# Webhook URL for alerts
WEBHOOK_URL=https://your-webhook-endpoint.com/alerts

# Alert on position out of range (default: true)
ALERT_ON_OUT_OF_RANGE=true

# Alert on IL threshold breach (default: true)
ALERT_ON_IL_THRESHOLD=true

# IL threshold for alerts in percentage (default: 2.0)
ALERT_IL_THRESHOLD_PCT=2.0

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# Log level: trace, debug, info, warn, error (default: info)
RUST_LOG=info

# Enable structured JSON logging (default: false)
LOG_JSON=false

# Log file path (optional, logs to stdout if not set)
# LOG_FILE=/var/log/clmm-lp/app.log

# -----------------------------------------------------------------------------
# Cache Configuration
# -----------------------------------------------------------------------------

# Cache directory for market data
CACHE_DIR=~/.cache/clmm-lp

# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL_SECS=3600

# Enable file-based caching (default: true)
CACHE_ENABLED=true
