# Generated by Cargo
# will have compiled files and executables
debug/
target/
**/target/
# Alternate target dir (local builds)
target2/
target-enrich-tmp/
target-agent-verify/
target-dev-api/

# Local tool caches (npm/temp redirected here on some setups)
.cache/

# Local caches, snapshots, reports (do not commit)
/data/
/data-backup/
/data-backup-runner/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock
**/Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb
.idea/
.run/
.env
# Default local wallet keypair JSONs (secrets)
/wallets/
.local/
/web/.env.local
/Docker/.erlang.cookie
/Doc/.*.drawio.bkp
/**/.DS_Store
src/.DS_Store
/*.profraw
/coverage/*.info
/cobertura.xml
/tarpaulin-report.html
.secrets
/scripts/
/web/package-lock.json
/web/node_modules/
/web/dist/

# Local logs (may contain secrets like RPC URLs)
/tools/logs/
*.log
